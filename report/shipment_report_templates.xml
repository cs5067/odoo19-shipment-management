<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_shipment_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <table style="width: 100%; margin-bottom: 16px;">
                            <tr>
                                <td style="width: 55%; vertical-align: middle;">
                                    <h2 style="margin-bottom: 0;">Shipment Order</h2>
                                    <h3 style="margin-top: 0; color: #666;">
                                        <span t-field="doc.name"/>
                                    </h3>
                                </td>
                                <td style="width: 45%; text-align: right; vertical-align: middle;">
                                    <img t-attf-src="data:image/png;base64,{{doc._get_barcode_base64()}}"
                                         style="width: 280px; height: 70px;" alt="Barcode"/>
                                </td>
                            </tr>
                        </table>

                        <table style="width: 100%; border-collapse: separate; border-spacing: 6px 0; margin-bottom: 16px;">
                            <tr>
                                <td style="width: 50%; border: 1px solid #999; border-radius: 4px; padding: 10px; vertical-align: top;">
                                    <div style="text-transform: uppercase; color: #666; font-size: 11px;">
                                        <strong>From</strong>
                                    </div>
                                    <div style="font-size: 16px; font-weight: bold;" t-field="doc.origin"/>
                                    <div style="margin-top: 6px;">
                                        <strong>Pickup:</strong>
                                        <span t-field="doc.pickup_date"/>
                                    </div>
                                </td>
                                <td style="width: 50%; border: 1px solid #999; border-radius: 4px; padding: 10px; vertical-align: top;">
                                    <div style="text-transform: uppercase; color: #666; font-size: 11px;">
                                        <strong>Deliver To</strong>
                                    </div>
                                    <div style="font-size: 16px; font-weight: bold;" t-field="doc.destination"/>
                                    <div t-field="doc.partner_id"
                                         t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                                    <div style="margin-top: 6px;">
                                        <strong>Delivery:</strong>
                                        <span t-field="doc.delivery_date"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-bottom: 12px;">
                            <span style="margin-right: 24px;">
                                <strong>Shipment Type:</strong>
                                <span t-field="doc.shipment_type_id.name"/>
                                (<span t-field="doc.shipment_type_id.code"/>)
                            </span>
                            <span style="margin-right: 24px;">
                                <strong>Category:</strong>
                                <span t-field="doc.shipment_type_id.category"/>
                            </span>
                            <span>
                                <strong>Packages:</strong>
                                <t t-out="'%g' % sum(doc.item_ids.mapped('quantity'))"/>
                            </span>
                        </div>

                        <table class="table table-sm" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Total Weight (kg)</th>
                                    <th class="text-end">Total Volume (m³)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.item_ids" t-as="item">
                                    <td><t t-out="item_index + 1"/></td>
                                    <td><span t-field="item.description"/></td>
                                    <td class="text-end"><span t-field="item.quantity"/></td>
                                    <td class="text-end"><span t-field="item.total_weight"/></td>
                                    <td class="text-end"><span t-field="item.total_volume"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td/>
                                    <td><strong>Total</strong></td>
                                    <td/>
                                    <td class="text-end">
                                        <strong t-field="doc.total_weight"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-field="doc.total_volume"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <table style="width: 100%; margin-top: 48px; border-collapse: separate; border-spacing: 12px 0;">
                            <tr>
                                <td style="width: 33%; vertical-align: bottom;">
                                    <p><strong>Driver</strong></p>
                                    <div style="margin-top: 48px; border-top: 1px solid #333; padding-top: 4px;">
                                        Name &amp; Signature
                                    </div>
                                    <div style="color: #666;">Date: ____________</div>
                                </td>
                                <td style="width: 33%; vertical-align: bottom;">
                                    <p><strong>Received By</strong></p>
                                    <div style="margin-top: 48px; border-top: 1px solid #333; padding-top: 4px;">
                                        Name &amp; Signature
                                    </div>
                                    <div style="color: #666;">Date: ____________</div>
                                </td>
                                <td style="width: 33%; vertical-align: bottom;">
                                    <p><strong>Prepared By</strong></p>
                                    <div style="margin-top: 48px; border-top: 1px solid #333; padding-top: 4px;">
                                        Name &amp; Signature
                                    </div>
                                    <div style="color: #666;">Date: ____________</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
