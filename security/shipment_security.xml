<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shipment" model="ir.module.category">
        <field name="name">Shipment Management</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_shipment" model="res.groups.privilege">
        <field name="name">Shipment Management</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_shipment"/>
    </record>

    <record id="group_shipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_shipment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and manage shipment requests.</field>
    </record>

    <record id="group_shipment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_shipment"/>
        <field name="implied_ids" eval="[(4, ref('group_shipment_user'))]"/>
        <field name="comment">Can also configure shipment types.</field>
    </record>
</odoo>
